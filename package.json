{
  "private": true,
  "author": "qq382724925 <382724935@qq.com>",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "start": "pnpm dev",
    "format": "biome check --write .",
    "biome:check": "biome check .",
    "lint": "pnpm biome:check && pnpm tsc && pnpm depcruise && pnpm openapi:check",
    "tsc": "tsc --noEmit",
    "depcruise": "depcruise src && node scripts/dependency-contract.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "doctor": "react-doctor . --no-supply-chain --no-score",
    "doctor:supply-chain": "react-doctor .",
    "antd:doctor": "NO_UPDATE_CHECK=1 antd doctor",
    "antd:lint": "NO_UPDATE_CHECK=1 antd lint src",
    "antd:usage": "NO_UPDATE_CHECK=1 antd usage src",
    "antd:check": "pnpm antd:doctor && pnpm antd:lint && pnpm antd:usage",
    "test:tooling": "node --test scripts/verify-structure.test.mjs scripts/verify-markdown.test.mjs",
    "verify:structure": "node scripts/verify-structure.mjs",
    "verify:markdown": "node scripts/verify-markdown.mjs README.md AGENTS.md CLAUDE.md docs",
    "verify": "pnpm lint && pnpm test:tooling && pnpm verify:structure && pnpm verify:markdown && pnpm test:coverage && pnpm run doctor && pnpm antd:check && pnpm build",
    "openapi:fetch": "node scripts/openapi.mjs fetch",
    "openapi:generate": "node scripts/openapi.mjs generate",
    "openapi:check": "node scripts/openapi.mjs check",
    "openapi:check:release": "node scripts/openapi.mjs check --require-pinned",
    "prepare": "husky",
    "postinstall": "max setup",
    "setup": "max setup",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/pro-components": "3.1.14-6",
    "@ant-design/x": "^2.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "antd": "^6.5.2",
    "antd-style": "^4.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.5.2",
    "@biomejs/biome": "^2.5.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@umijs/max": "^4.6.82",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "dependency-cruiser": "^18.1.1",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "openapi-typescript": "^7.13.0",
    "react-doctor": "^0.9.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
